# Variáveis públicas (vão para o bundle). Chave Pix é pública por natureza, mas não é commitada.
NEXT_PUBLIC_PIX_KEY=
NEXT_PUBLIC_PIX_NAME=VERTINTAS
NEXT_PUBLIC_PIX_CITY=JOAO PESSOA
# Só no GitHub Pages: /<nome-do-repositório>. Vazio em domínio próprio e local.
